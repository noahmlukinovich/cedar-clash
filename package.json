{
  "name": "cedarville-clash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && COOKIE_SECURE=0 DB_PATH=./data/dev.db node --disable-warning=ExperimentalWarning server-dist/server.mjs",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/cli.ts --bundle --platform=node --target=node22 --format=esm --define:__BUILD_TIME__=0 --outfile=server-dist/server.mjs --log-level=warning",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "admin": "node --disable-warning=ExperimentalWarning server-dist/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.13"
  }
}
