[Unit]
Description=Cedar Clash game server
After=network.target

[Service]
User=cedarclash
Group=cedarclash
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=DB_PATH=/var/lib/cedar-clash/cedar-clash.db
# Chapel "days" and real-world spring follow this time zone.
Environment=TZ=America/New_York
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/cedar-clash/app/server.mjs serve
Restart=on-failure
RestartSec=3

# Data lives only here; everything else on the disk is read-only to the game.
StateDirectory=cedar-clash
StateDirectoryMode=0700
UMask=0077

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

# Resource limits, so a bad day for the game can't take the whole droplet down.
MemoryMax=450M
CPUQuota=90%
TasksMax=64

[Install]
WantedBy=multi-user.target
